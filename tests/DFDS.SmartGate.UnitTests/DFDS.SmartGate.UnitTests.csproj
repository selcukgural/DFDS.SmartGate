<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\DFDS.SmartGate.Application\DFDS.SmartGate.Application.csproj" />
      <ProjectReference Include="..\..\src\DFDS.SmartGate.Domain\DFDS.SmartGate.Domain.csproj" />
      <!-- Host glue (claims → caller context, error mapping, filters) is pure logic and is unit-tested without a server. -->
      <ProjectReference Include="..\..\DFDS.SmartGate.Api\DFDS.SmartGate.Api.csproj" />
    </ItemGroup>

</Project>